# ── Java / Maven ──────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
.mvn/
!**/src/main/**/target/
!**/src/test/**/target/

# ── Maven tool (checked-in binary — should not be committed) ──
maven/
maven.zip

# ── Corporate / Zscaler certificates ─────────────────────────
*.pem
*.crt
*.cer

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# ── Secrets & environment ─────────────────────────────────────
.env
*.env
!.env.example

# ── Generated / runtime data ──────────────────────────────────
vector_store.json

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── Logs ──────────────────────────────────────────────────────
*.log
*.txt
!PROJECT_SUMMARY.txt
!README.md
!**/README.md
logs/
npm-debug.log*
yarn-debug.log*

# ── IDE / OS ──────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ── Chat / personal files ─────────────────────────────────────
chat-history*.json
